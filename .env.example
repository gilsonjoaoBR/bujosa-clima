# Número do WhatsApp Business, somente dígitos, no padrão E.164 com o Brasil (55).
# Ex.: 55 + DDD + número -> "55" "21" "9XXXXXXXX"
# Enquanto estiver vazio, nenhum link de WhatsApp é criado pelo site.
VITE_WHATSAPP_NUMBER=

# URL pública canônica, sem barra no final. Usada em canonical, Open Graph,
# sitemap.xml, robots.txt e nos dados estruturados.
VITE_SITE_URL=https://bujosaclima.com.br
